def parse_fasta(file):
    sequences = []
    current_seq = []
    with open(file, "r") as f:
        for line in f:
            line = line.strip()
            if line.startswith(">"):
                if current_seq:
                    sequences.append("".join(current_seq))
                    current_seq = []
            else:
                current_seq.append(line)
        if current_seq:
            sequences.append("".join(current_seq))
    return sequences

def calculate_stats(sequence):
  lengths = sorted([len(s) for s in sequence], reverse=True)
  num = len(lengths)
  total_length = sum(lengths)
  max_el = lengths[0]
  half_lengths = sum(lengths) / 2
  cumulative = 0
  n50 = 0
  for l in lengths:
    cumulative += l
    if cumulative >= half_lengths:
      n50 = l
      break
  return num, total_length, max_el, n50

contigs = parse_fasta("out_contig.fa")
contigs_stats = calculate_stats(contigs)
num, total, max, n50 = contigs_stats

print("contig's statistics")
print(f"Количество контигов: {num:,}")
print(f"Общая длина: {total:,} bp")
print(f"Самый длинный: {max:,} bp")
print(f"N50: {n50:,} bp")

